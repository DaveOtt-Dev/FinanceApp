// Finance App Prisma Schema
// Alternative to raw SQL migrations - provides type safety and easier migrations
// Usage: npx prisma migrate dev --name init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ========================================
// USERS TABLE
// ========================================
// Stores application user accounts and authentication details
model User {
  id                String          @id @default(uuid()) @db.Uuid
  email             String          @unique @db.VarChar(255)
  passwordHash      String          @map("password_hash") @db.VarChar(255)
  firstName         String?         @map("first_name") @db.VarChar(100)
  lastName          String?         @map("last_name") @db.VarChar(100)
  isActive          Boolean         @default(true) @map("is_active")
  isVerified        Boolean         @default(false) @map("is_verified")
  emailVerifiedAt   DateTime?       @map("email_verified_at") @db.Timestamp(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamp(3)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamp(3)

  // Relations
  plaidItems        PlaidItem[]
  plaidAccounts     PlaidAccount[]

  @@index([email])
  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

// ========================================
// PLAID_ITEMS TABLE
// ========================================
// Stores Plaid Item data (represents a user's login to a financial institution)
// Each Item can contain multiple Accounts from that institution
model PlaidItem {
  id                        String          @id @default(uuid()) @db.Uuid
  userId                    String          @map("user_id") @db.Uuid
  plaidItemId               String          @unique @map("plaid_item_id") @db.VarChar(255)
  accessTokenEncrypted      Bytes           @map("access_token_encrypted")
  encryptionKeyVersion      Int             @default(1) @map("encryption_key_version")
  institutionId             String?         @map("institution_id") @db.VarChar(255)
  institutionName           String?         @map("institution_name") @db.VarChar(255)
  isActive                  Boolean         @default(true) @map("is_active")
  lastSyncAt                DateTime?       @map("last_sync_at") @db.Timestamp(3)
  lastErrorMessage          String?         @map("last_error_message")
  lastErrorAt               DateTime?       @map("last_error_at") @db.Timestamp(3)
  createdAt                 DateTime        @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt                 DateTime        @updatedAt @map("updated_at") @db.Timestamp(3)

  // Relations
  user                      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidAccounts             PlaidAccount[]

  @@index([userId])
  @@index([plaidItemId])
  @@index([isActive])
  @@index([lastSyncAt])
  @@map("plaid_items")
}

// ========================================
// PLAID_ACCOUNTS TABLE
// ========================================
// Stores account metadata returned from Plaid /accounts/get endpoint
model PlaidAccount {
  id                String                    @id @default(uuid()) @db.Uuid
  plaidItemId       String                    @map("plaid_item_id") @db.Uuid
  userId            String                    @map("user_id") @db.Uuid
  plaidAccountId    String                    @map("plaid_account_id") @db.VarChar(255)
  accountName       String?                   @map("account_name") @db.VarChar(255)
  officialName      String?                   @map("official_name") @db.VarChar(255)
  accountType       String                    @map("account_type") @db.VarChar(50)
  accountSubtype    String?                   @map("account_subtype") @db.VarChar(50)
  accountMask       String?                   @map("account_mask") @db.VarChar(4)
  currencyCode      String                    @default("USD") @map("currency_code") @db.Char(3)
  isActive          Boolean                   @default(true) @map("is_active")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamp(3)

  // Relations
  plaidItem         PlaidItem                 @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  balances          PlaidAccountBalance[]

  @@unique([plaidItemId, plaidAccountId])
  @@index([userId])
  @@index([plaidItemId])
  @@index([plaidAccountId])
  @@index([isActive])
  @@map("plaid_accounts")
}

// ========================================
// PLAID_ACCOUNT_BALANCES TABLE
// ========================================
// Stores current and available balances for accounts
// This table is updated on each sync to maintain balance history
model PlaidAccountBalance {
  id                              String        @id @default(uuid()) @db.Uuid
  plaidAccountId                  String        @map("plaid_account_id") @db.Uuid
  currentBalance                  Decimal?      @map("current_balance") @db.Decimal(15, 2)
  availableBalance                Decimal?      @map("available_balance") @db.Decimal(15, 2)
  creditLimit                     Decimal?      @map("credit_limit") @db.Decimal(15, 2)
  lastUpdatedFromPlaidAt          DateTime      @map("last_updated_from_plaid_at") @db.Timestamp(3)
  createdAt                       DateTime      @default(now()) @map("created_at") @db.Timestamp(3)

  // Relations
  plaidAccount                    PlaidAccount  @relation(fields: [plaidAccountId], references: [id], onDelete: Cascade)

  @@index([plaidAccountId])
  @@index([createdAt])
  @@index([plaidAccountId, createdAt(sort: Desc)])
  @@map("plaid_account_balances")
}

// ========================================
// PLAID_SYNC_LOG TABLE
// ========================================
// Tracks synchronization timestamps and status for Items and Accounts
model PlaidSyncLog {
  id                  String        @id @default(uuid()) @db.Uuid
  entityType          String        @map("entity_type") @db.VarChar(50) // "item", "accounts", "balances"
  entityId            String        @map("entity_id") @db.Uuid
  syncStatus          String        @map("sync_status") @db.VarChar(20) // "success", "failure", "partial"
  startedAt           DateTime      @map("started_at") @db.Timestamp(3)
  completedAt         DateTime?     @map("completed_at") @db.Timestamp(3)
  durationMs          Int?          @map("duration_ms")
  recordsProcessed    Int?          @map("records_processed")
  errorMessage        String?       @map("error_message")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamp(3)

  @@index([entityId])
  @@index([entityType])
  @@index([syncStatus])
  @@index([createdAt])
  @@map("plaid_sync_log")
}

// ========================================
// ENUM TYPES (Optional, for type safety)
// ========================================

enum AccountType {
  DEPOSITORY
  CREDIT
  LOAN
  INVESTMENT
  MORTGAGE
  OTHER
}

enum SyncStatus {
  SUCCESS
  FAILURE
  PARTIAL
}
